# REQUIRED - Gemini API anahtarı (Google AI Studio üzerinden alınır)
GEMINI_API_KEY=

# Kullanılacak model (Gemini File Search destekli bir model olmalı)
GEMINI_MODEL=gemini-3.5-flash-lite

# Hiçbir araca özel belge yüklenmemişse kullanılacak genel File Search
# store ID'si (opsiyonel; admin panelinden araca özel PDF yüklendiğinde
# buna gerek kalmaz).
GEMINI_FILE_SEARCH_STORE_ID=

# Change these before production
APP_SECRET_KEY=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-immediately

# Prod'da https_only çerezleri zorunlu kılar (1=açık). Yalnızca localhost'ta
# http ile test ediyorsanız 0 yapın.
COOKIE_SECURE=1

# Neon PostgreSQL bağlantısı (Vercel Environment Variables içinde ayarlanır)
DATABASE_URL=

# Limits
QUESTIONS_PER_DAY=30
MAX_QUESTION_CHARS=2000

# ---------- Tarayıcı push bildirimleri (opsiyonel) ----------
# CBS sorusu admin tarafından cevaplandığında personelin telefonuna/tarayıcısına
# push bildirimi gönderebilmek için VAPID anahtar çifti gerekir. Boş bırakılırsa
# push bildirimi devre dışı kalır, uygulamanın geri kalanı normal çalışmaya devam eder.
#
# Kendi anahtarınızı üretmek için (HER DEPLOYMENT KENDİ ANAHTARINI ÜRETMELİ,
# aşağıdaki örnek anahtarları üretime taşımayın):
#   pip install py-vapid
#   python -c "
#   from py_vapid import Vapid02
#   from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat
#   import base64
#   v=Vapid02(); v.generate_keys()
#   b64=lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()
#   print('VAPID_PUBLIC_KEY=', b64(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)))
#   print('VAPID_PRIVATE_KEY=', b64(v.private_key.private_numbers().private_value.to_bytes(32,'big')))
#   "
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@ornek.com
