# REQUIRED
OPENAI_API_KEY=

# After running ingest.py, paste the Vector Store ID here.
OPENAI_VECTOR_STORE_ID=

# Choose a model available to your OpenAI project.
OPENAI_MODEL=

# Change these before production
APP_SECRET_KEY=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-immediately

# Neon PostgreSQL connection (set this in Vercel Environment Variables)
DATABASE_URL=

# Limits
QUESTIONS_PER_DAY=30
MAX_QUESTION_CHARS=2000
